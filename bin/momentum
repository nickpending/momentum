#!/usr/bin/env bash
# Momentum project launcher
# Ensures project exists, updates to latest version, launches Claude in project mode

set -e

# Colors for output
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
RESET='\033[0m'

# Load configuration first
WORKFLOW_CONFIG="$HOME/.config/momentum/config"
if [[ ! -f "$WORKFLOW_CONFIG" ]]; then
  echo -e "${RED}Error: Momentum not installed${RESET}"
  echo "Run the install script first: ./install.sh"
  exit 1
fi

source "$WORKFLOW_CONFIG"

# Parse flags
WORKSPACE_TAG=""
PROJECT_NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--name)
      WORKSPACE_TAG="$2"
      shift 2
      ;;
    -p|--project)
      PROJECT_NAME="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: momentum [-p <project>] [-n <workspace-tag>]"
      echo ""
      echo "Options:"
      echo "  -p, --project <name>   Open project mode for <name>"
      echo "  -n, --name <tag>       Start workspace with named tag"
      echo ""
      echo "Examples:"
      echo "  momentum               # Workspace mode (auto-tagged)"
      echo "  momentum -n wireframes # Workspace mode with tag"
      echo "  momentum argus         # Project mode (legacy)"
      echo "  momentum -p argus      # Project mode (explicit)"
      exit 0
      ;;
    *)
      # Legacy: positional arg is project name
      if [[ -z "$PROJECT_NAME" ]]; then
        PROJECT_NAME="$1"
      fi
      shift
      ;;
  esac
done

# Handle workspace mode (no project specified)
if [[ -z "$PROJECT_NAME" ]]; then
  PROJECT_DEV="$MOMENTUM_WORKSPACE/workspace"

  # Export workspace tag for hook to use
  if [[ -n "$WORKSPACE_TAG" ]]; then
    export MOMENTUM_WORKSPACE_TAG="$WORKSPACE_TAG"
  fi

  # Create workspace structure
  mkdir -p "$PROJECT_DEV/.claude/agents"

  # Create or update .claude/settings.json for workspace
  cat > "$PROJECT_DEV/.claude/settings.json" << EOF
{
  "\$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-session-start-hook.ts startup"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-session-start-hook.ts clear"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-user-prompt-submit-hook.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-stop-hook.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-pre-tool-use-hook.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-post-tool-use-hook.ts"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-subagent-stop-hook.ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/.config/momentum/hooks/momentum-session-end-hook.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "$HOME/.config/lore/",
      "$HOME/.local/share/lore/",
      "$HOME/.cache/lore/",
      "/tmp/"
    ],
    "allow": [
      "Bash(uv:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(pnpm:*)",
      "Bash(pytest:*)",
      "Bash(git:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(atuin search:*)",
      "Bash(prismis-cli:*)",
      "Bash(setupd:*)",
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "TodoWrite(*)",
      "Task(*)"
    ],
    "deny": [
      "Bash(diskutil:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(dd:*)"
    ]
  }
}
EOF

  # Create symlinks to momentum components
  rm -rf "$PROJECT_DEV/.claude/commands" 2>/dev/null || true
  ln -sf "$MOMENTUM_INSTALL/commands" "$PROJECT_DEV/.claude/commands"

  rm -rf "$PROJECT_DEV/.claude/skills" 2>/dev/null || true
  ln -sf "$MOMENTUM_INSTALL/skills" "$PROJECT_DEV/.claude/skills"

  for agent in "$MOMENTUM_INSTALL/subagents"/*.md; do
    if [[ -f "$agent" ]]; then
      ln -sf "$agent" "$PROJECT_DEV/.claude/agents/$(basename "$agent")" 2>/dev/null || true
    fi
  done

  # Create .mcp.json for playwright MCP server
  cat > "$PROJECT_DEV/.mcp.json" << 'EOF'
{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  }
}
EOF

  # Export base variables for hooks (required by momentum-paths.ts)
  export PROJECT_ROOT="$PROJECT_DEV"
  export PROJECT_NAME="workspace"
  export WORKFLOW_PROJECTS="$WORKFLOW_PROJECTS"

  # Launch in workspace
  cd "$PROJECT_DEV"
  exec claude --append-system-prompt "$(bun $MOMENTUM_INSTALL/hooks/render-project-prompt.ts)" "ready"
fi

# Project mode - handle named projects
# PROJECT_NAME already set from flag parsing
PROJECT_DEV="$WORKFLOW_DEV/$PROJECT_NAME"
PROJECT_PLANNING="$WORKFLOW_PROJECTS/$PROJECT_NAME"

# Create directories if missing
if [[ ! -d "$PROJECT_DEV" ]]; then
  echo -e "${YELLOW}Project '$PROJECT_NAME' doesn't exist.${RESET}"
  read -p "Create directories? (y/n): " CREATE
  if [[ "$CREATE" =~ ^[Yy]$ ]]; then
    mkdir -p "$PROJECT_DEV"
    mkdir -p "$PROJECT_PLANNING"
    echo -e "${GREEN}✅ Directories created${RESET}"
  else
    exit 1
  fi
fi

# Always check version and update (silent unless version changed)
setupd --switch "$PROJECT_NAME" 2>&1 | grep -E "(Updating|updated)" || true

# Export base variables for hooks (required by momentum-paths.ts)
export PROJECT_ROOT="$PROJECT_DEV"
export PROJECT_NAME="$PROJECT_NAME"
export WORKFLOW_PROJECTS="$WORKFLOW_PROJECTS"

# Launch momentum in project directory
cd "$PROJECT_DEV"
exec claude --append-system-prompt "$(bun $MOMENTUM_INSTALL/hooks/render-project-prompt.ts)" "ready"
