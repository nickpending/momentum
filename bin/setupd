#!/usr/bin/env bash
# setupd - Project setup for Momentum workflow
# Shell-agnostic, clear error messages, helpful guidance

set -e

# Colors (POSIX-compliant)
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
MAGENTA='\033[35m'
CYAN='\033[36m'
RESET='\033[0m'

# Load configuration
WORKFLOW_CONFIG="$HOME/.config/momentum/config"
if [[ -f "$WORKFLOW_CONFIG" ]]; then
    source "$WORKFLOW_CONFIG"
else
    echo -e "${RED}❌ Error: Momentum not installed${RESET}"
    echo "Run the install script first: ./install-interactive.sh"
    exit 1
fi

# Function to refresh/create project symlinks and settings
refresh_project_links() {
    local dev_project=$1
    local planning_project=$2
    local planning_exists=$3
    local quiet=${4:-false}

    # Commands directory
    if [[ -d "$MOMENTUM_HOME/commands" ]]; then
        mkdir -p "$dev_project/.claude"
        rm -rf "$dev_project/.claude/commands" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/commands" "$dev_project/.claude/commands"
    fi

    # Subagents directory
    if [[ -d "$MOMENTUM_HOME/subagents" ]]; then
        mkdir -p "$dev_project/.claude/agents"
        for agent in "$MOMENTUM_HOME/subagents"/*.md; do
            if [[ -f "$agent" ]]; then
                ln -sf "$agent" "$dev_project/.claude/agents/$(basename "$agent")" 2>/dev/null || true
            fi
        done
    fi

    # Hooks and contexts
    mkdir -p "$dev_project/.claude/hooks"
    # Clean up old hook symlink
    rm -f "$dev_project/.claude/hooks/momentum-hook.ts" 2>/dev/null || true

    if [[ -f "$MOMENTUM_HOME/hooks/momentum-session-start-hook.ts" ]]; then
        rm -f "$dev_project/.claude/hooks/momentum-session-start-hook.ts" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/hooks/momentum-session-start-hook.ts" "$dev_project/.claude/hooks/momentum-session-start-hook.ts"

        rm -f "$dev_project/.claude/hooks/momentum-user-prompt-submit-hook.ts" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/hooks/momentum-user-prompt-submit-hook.ts" "$dev_project/.claude/hooks/momentum-user-prompt-submit-hook.ts"

        rm -f "$dev_project/.claude/hooks/momentum-context-compression-hook.ts" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/hooks/momentum-context-compression-hook.ts" "$dev_project/.claude/hooks/momentum-context-compression-hook.ts"

        rm -rf "$dev_project/.claude/hooks/shared" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/hooks/shared" "$dev_project/.claude/hooks/shared"

        rm -rf "$dev_project/.workflow/contexts" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/contexts" "$dev_project/.workflow/contexts"
    fi

    # Templates and resources
    if [[ -d "$MOMENTUM_HOME/templates" ]]; then
        rm -rf "$dev_project/.workflow/templates" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/templates" "$dev_project/.workflow/templates"
    fi

    if [[ -d "$MOMENTUM_HOME/resources" ]]; then
        rm -rf "$dev_project/.workflow/resources" 2>/dev/null || true
        ln -sf "$MOMENTUM_HOME/resources" "$dev_project/.workflow/resources"
    fi

    # Settings file
    local settings_file="$dev_project/.claude/settings.json"
    if [[ "$planning_exists" == "true" ]]; then
        cat > "$settings_file" << EOF
{
  "\$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-session-start-hook.ts"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-session-start-hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-user-prompt-submit-hook.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-context-compression-hook.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      ".workflow/",
      "$planning_project",
      "$HOME/.config/lore/",
      "$HOME/.local/share/lore/",
      "$HOME/.cache/lore/",
      "/tmp/"
    ]
  }
}
EOF
    else
        cat > "$settings_file" << EOF
{
  "\$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-session-start-hook.ts"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-session-start-hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-user-prompt-submit-hook.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/momentum-context-compression-hook.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      ".workflow/",
      "$HOME/.config/lore/",
      "$HOME/.local/share/lore/",
      "$HOME/.cache/lore/",
      "/tmp/"
    ]
  }
}
EOF
    fi

    # Update version
    if [[ -f "$MOMENTUM_HOME/VERSION" ]]; then
        cp "$MOMENTUM_HOME/VERSION" "$dev_project/.workflow/version"
    fi
}

# Check for switch mode
if [[ "$1" == "--switch" ]]; then
    PROJECT_NAME=$2
    SWITCH_MODE=true

    if [[ -z "$PROJECT_NAME" ]]; then
        echo -e "${RED}❌ Error: Project name required${RESET}"
        echo "Usage: setupd --switch <project-name>"
        exit 1
    fi

    # Check if project has momentum setup
    DEV_PROJECT="$WORKFLOW_DEV/$PROJECT_NAME"
    PLANNING_PROJECT="$WORKFLOW_PROJECTS/$PROJECT_NAME"

    if [[ -d "$DEV_PROJECT/.workflow" ]]; then
        # Project exists - check version and update if needed
        PROJECT_VERSION=""
        MOMENTUM_VERSION=""

        if [[ -f "$DEV_PROJECT/.workflow/version" ]]; then
            PROJECT_VERSION=$(cat "$DEV_PROJECT/.workflow/version")
        fi

        if [[ -f "$MOMENTUM_HOME/VERSION" ]]; then
            MOMENTUM_VERSION=$(cat "$MOMENTUM_HOME/VERSION")
        fi

        # Update project if version mismatch
        if [[ -n "$MOMENTUM_VERSION" ]] && [[ "$PROJECT_VERSION" != "$MOMENTUM_VERSION" ]]; then
            if [[ -z "$PROJECT_VERSION" ]]; then
                echo "Initializing project version to $MOMENTUM_VERSION..."
            else
                echo "Updating project from $PROJECT_VERSION to $MOMENTUM_VERSION..."
            fi

            # Determine if planning exists for this project
            needs_planning="false"
            if [[ -d "$PLANNING_PROJECT" ]] && [[ -f "$PLANNING_PROJECT/IDEA.md" ]]; then
                needs_planning="true"
            fi

            # Refresh symlinks to latest momentum installation
            refresh_project_links "$DEV_PROJECT" "$PLANNING_PROJECT" "$needs_planning" true
            echo "✅ Project updated to $MOMENTUM_VERSION"
        fi

        echo "READY: Project '$PROJECT_NAME' is set up and ready"
        echo "ACTION: cd $DEV_PROJECT"
        exit 0
    elif [[ -f "$PLANNING_PROJECT/IDEA.md" ]]; then
        # Has idea, needs setup
        echo "SETUP: Found IDEA.md for '$PROJECT_NAME', creating project structure..."
        # Continue to setup flow
    else
        # No project, no idea
        echo "ERROR: No project '$PROJECT_NAME' found and no IDEA.md exists"
        echo "HELP: Create with 'setupd $PROJECT_NAME' or start with ideation"
        exit 1
    fi
else
    # Normal setup mode
    PROJECT_NAME=$1
    SWITCH_MODE=false

    if [[ -z "$PROJECT_NAME" ]]; then
        echo -e "${RED}❌ Error: Project name required${RESET}"
        echo
        echo "Usage: setupd <project-name>"
        echo "       setupd --switch <project-name>"
        echo
        echo "Examples:"
        echo "  setupd myapp"
        echo "  setupd tools/mytool  (for nested projects)"
        echo "  setupd --switch myapp  (check and switch to project)"
        echo
        echo "Note: Run this AFTER creating IDEA.md with:"
        echo "  1. /ideate (in Claude Code)"
        echo "  2. /plan-idea (in Claude Code)"
        exit 1
    fi
fi

# Parse project name for nested structure
if [[ "$PROJECT_NAME" == */* ]]; then
    PARENT_PROJECT="${PROJECT_NAME%/*}"
    SUB_PROJECT="${PROJECT_NAME##*/}"
    PLANNING_PROJECT="$WORKFLOW_PROJECTS/$PROJECT_NAME"
    DEV_PROJECT="$WORKFLOW_DEV/$PROJECT_NAME"
    
    echo -e "${BLUE}🔍 Nested project detected: $PARENT_PROJECT/$SUB_PROJECT${RESET}"
else
    PLANNING_PROJECT="$WORKFLOW_PROJECTS/$PROJECT_NAME"
    DEV_PROJECT="$WORKFLOW_DEV/$PROJECT_NAME"
fi

# Check if directories are configured
if [[ -z "$WORKFLOW_PROJECTS" ]] || [[ -z "$WORKFLOW_DEV" ]]; then
    echo -e "${RED}❌ Error: Workspace directories not configured${RESET}"
    echo "Please run the installer first: ./install-interactive.sh"
    exit 1
fi

# Check if obsidian project exists
PLANNING_EXISTS=true

if [[ "$PROJECT_NAME" == */* ]]; then
    # Nested project - might be an extracted tool
    if [[ ! -d "$PLANNING_PROJECT" ]]; then
        echo -e "${YELLOW}⚠️  Planning directory not found: $PLANNING_PROJECT${RESET}"
        echo -e "${CYAN}This is normal for extracted tools that don't need separate planning.${RESET}"
        PLANNING_EXISTS=false
    else
        if [[ ! -f "$PLANNING_PROJECT/IDEA.md" ]]; then
            echo -e "${YELLOW}⚠️  IDEA.md not found in $PLANNING_PROJECT${RESET}"
            echo
            echo "Create it first with:"
            echo "  1. Run: momentum (in terminal)"
            echo "  2. Run: /ideate 'your project idea' (in Claude Code)"
            echo "  3. Run: /plan-idea (in Claude Code)"
            echo "  4. Then run setupd again"
            exit 1
        fi
        echo -e "${GREEN}✅ Found nested project with IDEA.md${RESET}"
    fi
else
    # Flat project - should exist in obsidian
    if [[ ! -d "$PLANNING_PROJECT" ]]; then
        echo -e "${RED}❌ Project not found: $PLANNING_PROJECT${RESET}"
        echo
        
        # Try to find similar projects
        echo "Looking for similar projects..."
        found_similar=false
        if [[ -d "$WORKFLOW_PROJECTS" ]]; then
            for dir in "$WORKFLOW_PROJECTS"/*; do
                if [[ -d "$dir" ]]; then
                    basename_dir=$(basename "$dir")
                    if [[ "$basename_dir" == *"$PROJECT_NAME"* ]] || [[ "$PROJECT_NAME" == *"$basename_dir"* ]]; then
                        echo -e "${CYAN}  Did you mean: $basename_dir ?${RESET}"
                        found_similar=true
                    fi
                fi
            done
        fi
        
        if [[ "$found_similar" == "false" ]]; then
            echo "  No similar projects found"
        fi
        
        echo
        echo "To create a new project:"
        echo "  1. Run: momentum (in terminal)"
        echo "  2. Run: /ideate 'your project idea' (in Claude Code)"
        echo "  3. Run: /plan-idea (in Claude Code)"
        echo "  4. Then run: setupd $PROJECT_NAME"
        exit 1
    fi
    
    # Check for IDEA.md
    if [[ ! -f "$PLANNING_PROJECT/IDEA.md" ]]; then
        echo -e "${RED}❌ IDEA.md not found in $PLANNING_PROJECT${RESET}"
        echo
        echo "IDEA.md is required to set up a project."
        echo "Create it with:"
        echo "  1. Run: momentum (in terminal)"
        echo "  2. Run: /ideate 'your project idea' (in Claude Code)"
        echo "  3. Run: /plan-idea (in Claude Code)"
        echo
        echo "This creates the project vision that drives development."
        exit 1
    fi
    
    echo -e "${GREEN}✅ Found project with IDEA.md${RESET}"
fi

# Check if dev project already exists
if [[ -d "$DEV_PROJECT" ]]; then
    if [[ ! -d "$DEV_PROJECT/.workflow" ]]; then
        echo -e "${YELLOW}⚠️  Project exists without .workflow directory${RESET}"
        echo "Adding Momentum workflow structure..."
    else
        echo -e "${CYAN}ℹ️  Project already set up, refreshing symlinks...${RESET}"
    fi
else
    echo -e "${CYAN}Creating development project...${RESET}"
fi

echo
echo -e "${MAGENTA}🚀 Setting up: $PROJECT_NAME${RESET}"
echo -e "${CYAN}📁 Planning: $PLANNING_PROJECT${RESET}"
echo -e "${CYAN}💻 Development: $DEV_PROJECT${RESET}"
echo

# Create dev project directory structure
mkdir -p "$DEV_PROJECT/.workflow/artifacts"
mkdir -p "$DEV_PROJECT/.workflow/artifacts/subagents"
mkdir -p "$DEV_PROJECT/.workflow/archives"
mkdir -p "$DEV_PROJECT/.workflow/state"

# Symlink planning artifacts from Obsidian (if they exist)
obsidian_count=0
if [[ "$PLANNING_EXISTS" == "true" ]]; then
    # Link IDEA.md
    if [[ -f "$PLANNING_PROJECT/IDEA.md" ]]; then
        ln -sf "$PLANNING_PROJECT/IDEA.md" "$DEV_PROJECT/.workflow/artifacts/IDEA.md" 2>/dev/null || true
        ((obsidian_count++))
    fi
    
    # Link COMPOSITION_ARCHITECTURE.md if it exists
    if [[ -f "$PLANNING_PROJECT/COMPOSITION_ARCHITECTURE.md" ]]; then
        ln -sf "$PLANNING_PROJECT/COMPOSITION_ARCHITECTURE.md" "$DEV_PROJECT/.workflow/artifacts/COMPOSITION_ARCHITECTURE.md" 2>/dev/null || true
        ((obsidian_count++))
    fi
    
    echo -e "${GREEN}✅ Planning files: $obsidian_count files linked${RESET}"
else
    echo -e "${YELLOW}⚠️  Planning files: Skipped (no planning directory)${RESET}"
fi

# Check for existing iteration files
iteration_count=0
if [[ -f "$DEV_PROJECT/.workflow/artifacts/ITERATION.md" ]]; then
    ((iteration_count++))
fi
if [[ -f "$DEV_PROJECT/.workflow/artifacts/TASKS.md" ]]; then
    ((iteration_count++))
fi

if [[ $iteration_count -gt 0 ]]; then
    echo -e "${GREEN}✅ Iteration files: $iteration_count files found${RESET}"
else
    echo -e "${CYAN}ℹ️  Iteration files: None yet (create with /plan-iteration)${RESET}"
fi

# Link workflow resources from momentum installation
refresh_project_links "$DEV_PROJECT" "$PLANNING_PROJECT" "$PLANNING_EXISTS" false

# Validate installation
resource_missing=""
if [[ ! -d "$MOMENTUM_HOME/commands" ]]; then
    resource_missing="${resource_missing}commands "
fi
if [[ ! -d "$MOMENTUM_HOME/subagents" ]]; then
    resource_missing="${resource_missing}subagents "
fi
if [[ ! -d "$MOMENTUM_HOME/templates" ]]; then
    resource_missing="${resource_missing}templates "
fi
if [[ ! -d "$MOMENTUM_HOME/resources" ]]; then
    resource_missing="${resource_missing}resources "
fi

# Report subagent count
if [[ -d "$MOMENTUM_HOME/subagents" ]]; then
    subagent_count=$(ls -1 "$MOMENTUM_HOME/subagents"/*.md 2>/dev/null | wc -l)
    echo -e "${GREEN}✅ Project subagents: $subagent_count linked${RESET}"
fi

echo -e "${GREEN}✅ Project hooks: Momentum hook linked${RESET}"
echo -e "${GREEN}✅ Project contexts: Symlinked to .workflow${RESET}"

if [[ "$PLANNING_EXISTS" == "true" ]]; then
    echo -e "${GREEN}✅ Claude settings: Hook activated with planning access${RESET}"
else
    echo -e "${GREEN}✅ Claude settings: Hook activated${RESET}"
fi

# Check if all resources linked
if [[ -n "$resource_missing" ]]; then
    echo -e "${RED}❌ Missing components: $resource_missing${RESET}"
    echo "Momentum installation may be incomplete."
    echo "Try running the installer again: ./install-interactive.sh"
    exit 1
else
    echo -e "${GREEN}✅ Workflow components: All 3 linked successfully${RESET}"
fi

# Check for claudex standards (optional)
if [[ -d "$HOME/.claudex/standards" ]]; then
    standard_count=$(ls -1 "$HOME/.claudex/standards"/*.md 2>/dev/null | wc -l)
    if [[ $standard_count -gt 0 ]]; then
        echo -e "${GREEN}✅ Claudex standards: $standard_count available${RESET}"
    fi
else
    echo -e "${CYAN}ℹ️  Claudex standards: Not found (optional)${RESET}"
fi

echo
echo -e "${GREEN}╔════════════════════════════════════════╗${RESET}"
echo -e "${GREEN}║   Project ready for Momentum! 🎉      ║${RESET}"
echo -e "${GREEN}╚════════════════════════════════════════╝${RESET}"
echo

# Provide clear next steps
echo -e "${MAGENTA}NEXT STEPS:${RESET}"
echo

if [[ $iteration_count -eq 0 ]]; then
    # No iteration files - start fresh
    echo "1. Navigate to project:"
    echo -e "   ${CYAN}cd $DEV_PROJECT${RESET}"
    echo
    echo "2. Start Momentum mode:"
    echo -e "   ${CYAN}momentum${RESET}"
    echo
    echo "3. Plan your first iteration (in Claude Code):"
    echo -e "   ${CYAN}/plan-iteration${RESET}"
    echo
    echo "4. Break into tasks (in Claude Code):"
    echo -e "   ${CYAN}/decompose-iteration${RESET}"
    echo
    echo "5. Start building (in Claude Code):"
    echo -e "   ${CYAN}/plan-task 1${RESET}"
else
    # Has iteration files - continue work
    echo "1. Navigate to project:"
    echo -e "   ${CYAN}cd $DEV_PROJECT${RESET}"
    echo
    echo "2. Start Momentum mode:"
    echo -e "   ${CYAN}momentum${RESET}"
    echo
    echo "3. Load context (in Claude Code):"
    echo -e "   ${CYAN}/load-app-context${RESET}"
    echo
    echo "4. Continue with next task (in Claude Code):"
    echo -e "   ${CYAN}/plan-task N${RESET}"
fi

echo
echo -e "${YELLOW}Remember: All /commands run in Claude Code, not terminal!${RESET}"
echo
echo -e "${GREEN}Ship working software every iteration! 🚀${RESET}"

# If in switch mode, output simple status
if [[ "$SWITCH_MODE" == "true" ]]; then
    echo
    echo "READY: Project '$PROJECT_NAME' created and ready"
    echo "ACTION: cd $DEV_PROJECT"
fi